# Required: character set used to encode short codes (no defaults in code).
ALPHABET=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

# Required: link lifetime, Go duration format (e.g. 720h, 30m, 1h30m).
TTL=720h

# Required: Redis endpoint. Either plain host:port, or a URL:
#   redis://host:port        (plain)
#   rediss://host:port       (TLS, most cloud providers)
#   rediss://user:pass@host:port/0
REDIS_ADDR=localhost:6379

# Optional ACL/credentials (ignored if already embedded in REDIS_ADDR URL).
REDIS_USERNAME=
REDIS_PASSWORD=

# Optional: public base URL used in short_url responses.
BASE_URL=http://localhost:8080

# Optional: listen address for the HTTP server.
PORT=:8080
